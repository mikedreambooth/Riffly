# Which riff generator the server/CLI uses: "gemini" or "fixture"
RIFFLY_PROVIDER=fixture

# Gemini (Google AI Studio key). Alternatively use Vertex AI by setting
# GOOGLE_GENAI_USE_VERTEXAI=true, GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

PORT=8787
